# Full HTTPS URLs for each protected source feed. Leave a source unset to show
# it as unconfigured. Tokens are read only by the server route.
RATICROSS_RECEIPTS_URL=
RATICROSS_RECEIPTS_TOKEN=

SIGNAL_RECEIPTS_URL=
SIGNAL_RECEIPTS_TOKEN=

# Example shape: https://cosy.example/moderation/events?limit=100
COSYWORLD_RECEIPTS_URL=
COSYWORLD_MODERATION_TOKEN=

# May point at a Swarm activity, audit-log, or fast logs endpoint.
SWARM_RECEIPTS_URL=
SWARM_RECEIPTS_TOKEN=
