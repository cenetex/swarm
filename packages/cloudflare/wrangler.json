{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "swarm-hosted-local",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "assets": {
    "directory": "../admin-ui/dist-hosted",
    "binding": "SWARM_ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "SWARM_ENV": "development",
    "SWARM_HOSTED_ENABLED": "0",
    "SWARM_PUBLIC_URL": "http://localhost:8787",
    "SWARM_SOLANA_CHAIN_ID": "mainnet",
    "SWARM_USER_SECRET_KEY_VERSION": "local_v1",
    "SWARM_OPENROUTER_RETURN_PATH": "/studio?ai=openrouter",
    "SWARM_OPENROUTER_MODEL": "openrouter/free",
    "SWARM_HOSTED_CHAT_RATE_LIMIT": "20"
  },
  "secrets": {
    "required": ["SWARM_USER_SECRET_KEK"]
  },
  "d1_databases": [
    {
      "binding": "SWARM_STATE",
      "database_name": "swarm-hosted-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SWARM_BLOBS",
      "bucket_name": "swarm-hosted-local"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "SWARM_QUEUE",
        "queue": "swarm-hosted-local"
      }
    ],
    "consumers": [
      {
        "queue": "swarm-hosted-local",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SWARM_AVATAR_COORDINATORS",
        "class_name": "HostedAvatarCoordinatorDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "hosted-avatar-coordinator-v1",
      "new_sqlite_classes": ["HostedAvatarCoordinatorDurableObject"]
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
