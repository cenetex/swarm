{
  "name": "@swarm/cloudflare",
  "version": "0.1.0",
  "description": "Cloudflare-native hosted platform adapter for Swarm",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "bun": "./src/worker.ts",
      "types": "./src/worker.ts",
      "import": "./dist/worker.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc -b",
    "test": "bun test",
    "lint": "eslint --max-warnings 0 src/",
    "probe:x": "bun scripts/probe-x-oauth.mjs",
    "deploy:config": "node scripts/render-wrangler-config.mjs",
    "predeploy:dry-run": "pnpm --filter @swarm/admin-ui build:hosted && tsc -b",
    "deploy:dry-run": "WRANGLER_WRITE_LOGS=false wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "@simplewebauthn/server": "13.3.3",
    "@swarm/core": "workspace:*",
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "wrangler": "4.127.1"
  }
}
