#!/usr/bin/env sh
set -e

# Keep the local hook fast. CI owns validation before merge.
# Skip with: SKIP_PRECOMMIT=1 git commit
if [ "${SKIP_PRECOMMIT:-}" = "1" ] || [ "${SKIP_PRECOMMIT:-}" = "true" ]; then
	echo "pre-commit: SKIP_PRECOMMIT set; skipping checks"
	exit 0
fi

# Keep changes on PR branches.
BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$BRANCH" = "main" ]; then
	echo "ERROR: Do not commit directly to main. Create any short-lived branch first."
	exit 1
fi

git diff --cached --check
