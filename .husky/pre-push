#!/usr/bin/env sh
set -e

# CI owns lint, build, and test before merge. Pushing a branch is intentionally
# frictionless so developers and agents can publish work quickly.
# Skip with: SKIP_PREPUSH=1 git push
if [ "${SKIP_PREPUSH:-}" = "1" ] || [ "${SKIP_PREPUSH:-}" = "true" ]; then
  echo "pre-push: SKIP_PREPUSH set; skipping checks"
  exit 0
fi

echo "pre-push: validation runs in CI"
